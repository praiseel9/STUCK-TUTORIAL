body { 
    font-family: Arial, sans-serif; 
    line-height: 1.6; 
    padding: 20px; 
    max-width: 800px; 
    margin: auto; 
    background-color: #f4f4f4;
}
header { 
    background: #1a1a1a; 
    color: #fff; 
    padding: 2rem; 
    text-align: center; 
    border-radius: 8px;
}
section { 
    background: white; 
    padding: 20px; 
    margin-top: 20px; 
    border-radius: 8px; 
}
